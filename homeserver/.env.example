# Copiar para .env (chmod 600). Nunca versionar o .env.
TZ=America/Sao_Paulo

# Gerados na instalação (scripts/instalar.sh)
POSTGRES_PASSWORD=
CASA_TOKEN=

# Código de pareamento do Homebridge (copiado do homebridge/config.json pelo instalar.sh)
HOMEBRIDGE_PIN=

# Tarifa de energia em R$/kWh para estimar o custo no painel (ex.: 0.95). Vazio = não mostra R$.
TARIFA_KWH=

# Player 2.0 (casa-play): token de leitura da API do TMDB (v4 "API Read Access Token"; a chave v3 também serve).
TMDB_TOKEN=

# Opcional: API oficial do OpenSubtitles como 2ª fonte de legendas (a 1ª é o add-on público do Stremio, sem chave).
# Usuário/senha aumentam o limite de downloads por dia (5 → 20).
OPENSUBTITLES_KEY=
OPENSUBTITLES_USUARIO=
OPENSUBTITLES_SENHA=

# Trakt (opcional): client id de um app criado em https://trakt.tv/oauth/applications (recomendações).
TRAKT_CLIENT_ID=

# TV nova precisa ser aprovada no painel (Player › Listas e TVs). 0 = entra sem aprovação: qualquer
# aparelho da rede local pode se registrar como TV e ler a conta do painel. Recomendado: 1.
PLAY_APROVACAO=1

# Clima da Home das TVs (Open-Meteo, sem chave). Padrão: São Paulo.
CLIMA_CIDADE=
CLIMA_LAT=
CLIMA_LON=
